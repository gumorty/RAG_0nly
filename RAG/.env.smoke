APP_ENV=development
APP_SECRET=smoke-secret
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_API_KEY=smoke-admin-key-change-me
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=RAG Admin
BOOTSTRAP_ADMIN_API_KEY=smoke-admin-key-change-me

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rag
SPRING_DATASOURCE_USERNAME=rag
SPRING_DATASOURCE_PASSWORD=rag_password
DATABASE_URL=postgresql+psycopg://rag:rag_password@postgres:5432/rag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rag_chunks

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=rag_minio
MINIO_SECRET_KEY=rag_minio_password
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

LLM_PROVIDER=mock
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=mock
LLM_MODEL=mock-rag

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-384
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_RERANKER=false

CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_KEYWORD_TOP_K=30
RETRIEVAL_FINAL_TOP_K=8
MIN_ANSWER_EVIDENCE_SCORE=0.0
INGESTION_MODE=sync
