APP_ENV=development
APP_SECRET=change-me
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_API_KEY=change-this-admin-api-key
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=RAG Admin
BOOTSTRAP_ADMIN_API_KEY=change-this-admin-api-key
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rag
SPRING_DATASOURCE_USERNAME=rag
SPRING_DATASOURCE_PASSWORD=rag_password
DATABASE_URL=postgresql+psycopg://rag:rag_password@postgres:5432/rag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rag_chunks

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=rag_minio
MINIO_SECRET_KEY=rag_minio_password
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

LLM_PROVIDER=mock
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=change-me
LLM_MODEL=qwen3.6-35b-a3b-fp8

# Alibaba Cloud Model Studio / Bailian uses an OpenAI-compatible endpoint.
# Configure the same values in the frontend "模型路由" panel and activate it,
# or use them here as the bootstrapped default model route.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-your-dashscope-api-key
# LLM_MODEL=qwen-plus

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_RERANKER=false

CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_KEYWORD_TOP_K=30
RETRIEVAL_FINAL_TOP_K=8
MIN_ANSWER_EVIDENCE_SCORE=0.15
INGESTION_MODE=async
