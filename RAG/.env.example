APP_ENV=development
APP_SECRET=change-me
PUBLIC_REGISTRATION_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:4070,http://localhost:3010,http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_API_KEY=change-this-admin-api-key
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=RAG Admin
BOOTSTRAP_ADMIN_API_KEY=change-this-admin-api-key
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

DATABASE_URL=postgresql+psycopg://rag:rag_password@postgres:5432/rag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rag_chunks

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=rag_minio
MINIO_SECRET_KEY=rag_minio_password
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-dashscope-api-key
LLM_MODEL=qwen3.7-plus

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-384
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_RERANKER=false

CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_KEYWORD_TOP_K=30
RETRIEVAL_FINAL_TOP_K=8
MIN_ANSWER_EVIDENCE_SCORE=0.22
INGESTION_MODE=async
MAX_UPLOAD_SIZE_MB=100
MAX_ZIP_UPLOAD_SIZE_MB=500
ALLOW_PRIVATE_URL_INGEST=false

RAGFLOW_ENABLED=true
RAGFLOW_BASE_URL=http://ragflow-gpu:9380/api/v1
RAGFLOW_API_KEY=ragflow-local-api-token
RAGFLOW_CHAT_MODEL=qwen3.7-plus@default@OpenAI-API-Compatible
RAGFLOW_EMBEDDING_MODEL=text-embedding-v4@default@OpenAI-API-Compatible
RAGFLOW_PARSE_TIMEOUT_SECONDS=900
RAGFLOW_SYNC_INTERVAL_SECONDS=120
RAGFLOW_ENABLE_CHAT_COMPLETIONS=true
RAGFLOW_DEFAULT_CHUNK_METHOD=naive
RAGFLOW_RERANKER_MODEL=
RAGFLOW_ENABLE_AGENT=false
RAGFLOW_AGENT_TEMPLATE=qa_agent
RAGFLOW_KG_ENABLED_DEFAULT=false
